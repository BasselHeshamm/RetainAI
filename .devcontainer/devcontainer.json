{
  "name": "RetainAI",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pip install -r requirements.txt && python scripts/setup_data.py",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": {"label": "Streamlit app", "onAutoForward": "openBrowser"},
    "8000": {"label": "FastAPI"}
  },
  "secrets": {
    "GOOGLE_API_KEY": {
      "description": "Gemini API key for the agents",
      "documentationUrl": "https://aistudio.google.com/apikey"
    }
  },
  "customizations": {
    "vscode": {"extensions": ["ms-python.python"]}
  }
}
