# Free and fastest to set up: https://console.groq.com/keys
GROQ_API_KEY=
# Copy to .env and fill in. Get a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Any current Gemini model id from https://ai.google.dev/gemini-api/docs/models
# RETAINAI_MODEL=  (optional: override the default model)
# Max supervisor routing steps per question
RETAINAI_MAX_STEPS=6
# Set to "hashing" to skip downloading the local embedding model (lower RAG quality)
# RETAINAI_EMBEDDINGS=hashing
